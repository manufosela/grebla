---
import Base from '../layouts/Base.astro';

/**
 * Organigrama (RMR-PRP-0002, RMR-TSK-0671): consulta de SOLO LECTURA. El árbol
 * invertido de cada rama (liderazgo afectivo), con zoom. Accesible por
 * cualquier empleado logado; los datos llegan por la callable orgDirectory.
 */
---

<Base title="GREBLA — Organigrama" requireAuth={true}>
  <tool-nav href="/" name="Organigrama" icon="🔻"></tool-nav>
  <p class="page-lead">
    Así se organiza la casa: una pirámide invertida, donde quien más
    responsabilidad tiene está abajo, sosteniendo a todo el equipo.
  </p>

  <org-branch-chart></org-branch-chart>
</Base>

<script>
  import '../components/common/tool-nav.js';
  import '../components/org-branch-chart.js';
  import { onUserChanged } from '../lib/auth.js';
  import { resolveAccess } from '../lib/access.js';
  import { canGovern } from '../lib/accessRoles.js';
  import { guardToolPage } from '../lib/toolGate.js';

  // Gate por política de la herramienta (RMR-TSK-0387): si la política deniega,
  // el componente se sustituye por la pantalla de sin-acceso (deja de cargar).
  onUserChanged(async (user) => {
    if (!user) return;
    let isSuperadmin = false;
    try { isSuperadmin = canGovern(await resolveAccess(user)); } catch { /* sin gobierno */ }
    await guardToolPage('organigrama', user, { isSuperadmin, appEl: document.querySelector('org-branch-chart') });
  });
</script>
