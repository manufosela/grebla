---
import Base from '../../layouts/Base.astro';

/**
 * Panel de gestión del superadmin (modelo multi-leader): gestión de managers y
 * vista en lectura de sus equipos. El glue verifica el rol; un manager puro o un
 * usuario sin acceso es redirigido fuera.
 */
---

<Base title="GREBLA — Gestión" requireAuth={true}>
  <!-- Se entra por su card del hub, así que también se sale por donde se sale
       de las demás (RMR-TSK-0461). -->
  <tool-nav href="/" name="Administración" icon="🛠️"></tool-nav>
  <superadmin-panel></superadmin-panel>

  <script>
    import '../../components/common/tool-nav.js';
    import '../../client/superadmin.js';
  </script>
</Base>
