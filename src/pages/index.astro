---
import Base from '../layouts/Base.astro';
import { HUB_TOOLS as tools, TOOL_ID } from '../data/hubCards.js';
import { HUB_GROUPS, GROUP_IDS, groupOf } from '../lib/hubGroups.js';

/**
 * Las tarjetas repartidas por grupo, en el orden de los grupos. Se pinta EL
 * CATALOGO ENTERO; landing.js oculta despues lo que no toca y retira los
 * encabezados que se queden sin nada debajo. Pintarlo al reves —decidir aqui
 * que grupos existen— haria falta saber quien eres antes de servir la pagina.
 */
const byGroup = GROUP_IDS
  .map((id) => ({ group: HUB_GROUPS[id], cards: tools.filter((t) => groupOf(t) === id) }))
  .filter((g) => g.cards.length > 0);

/**
 * Hub de herramientas, agrupado por PROPOSITO (ADR «El inicio se agrupa por
 * propósito», que sustituye al de las tres capas).
 *
 * Cada herramienta declara para qué sirve —lo tuyo, tu equipo, cómo estamos,
 * cómo entregamos, la casa— y no a quién pertenece. Quien entra no busca «algo
 * de TRIBBU»: busca preparar un 1:1 o ver cómo va su carrera.
 *
 * Las capas TRIBBU / Ingeniería se retiraron con este cambio: dos ejes de
 * agrupación a la vez obligan a adivinar en qué pestaña vive cada cosa antes de
 * buscar el grupo.
 *
 * La ADMINISTRACIÓN no es una tarjeta ni un grupo: es un enlace aparte que abre
 * en ventana propia, porque es gobierno y no uso diario, y porque su página ya
 * tiene sus propias secciones dentro.
 */
---

<Base title="GREBLA">
  <section class="hero">
    <h1 class="page-title">GREBLA</h1>
    <p class="page-tagline">Gestión Reflexiva de Equipos Bajo un Liderazgo Afectivo</p>
    <p class="page-lead">
      Herramientas para entender y desarrollar a tus equipos y a las personas
      que los forman.
    </p>
  </section>

  <!-- Cargando (RMR-BUG-0090): visible por DEFECTO para no enseñar la landing
       pública a quien vuelve con sesión; landing.js decide (skeleton → tools o
       landing). Altura reservada contra el layout shift. -->
  <noscript>
    <style>
      #hub-loading { display: none; }
      #platform-landing[hidden] { display: block; }
    </style>
  </noscript>
  <section id="hub-loading" class="hub-loading" aria-busy="true">
    <span class="hub-spinner" aria-hidden="true"></span>
    <p class="muted">Cargando tu espacio…</p>
  </section>

  <!-- Sin sesión/acceso: OCULTA hasta confirmar que no hay sesión. -->
  <section id="platform-landing" class="landing" hidden>
    <div id="landing-anon">
      <p class="page-lead">Inicia sesión arriba a la derecha para acceder a las herramientas.</p>
      <p class="muted">
        Si no tienes acceso, pide a un superadmin de la organización que te dé de alta como manager.
      </p>
    </div>
    <!-- Con sesión pero sin sitio en esta instancia (RMR-TSK-0519): se dice
         claro, en vez de enseñar la portada muda de quien no ha entrado. -->
    <div id="landing-no-access" hidden>
      <p class="page-lead">Has entrado, pero esta instancia no te reconoce.</p>
      <p class="muted">
        Tu cuenta no tiene ficha ni acceso aquí. Si deberías tenerlo, pide a un superadmin que te dé de alta.
      </p>
    </div>
  </section>


  <!-- El enlace de administracion (ADR de los grupos, regla G): gobierno y uso
       diario no se mezclan, asi que no es un grupo ni una tarjeta. Oculto hasta
       saber quien eres: pintarlo antes haria saltar el contenido. -->
  <nav id="hub-bar" class="hub-bar" aria-label="Administracion" hidden>
    <a id="admin-link" class="admin-link" href="/admin" target="_blank" rel="noopener" hidden>
      🛠️ Administración <span class="ext" aria-hidden="true">↗</span>
    </a>
  </nav>

  <!-- Herramientas: ocultas por defecto. landing.js las muestra con sesión y acceso. -->
  <!-- Herramientas: ocultas por defecto. landing.js las muestra con sesion y
       acceso, y retira los grupos que se queden sin ninguna visible. -->
  <div id="tenant-tools" hidden>
    {
      byGroup.map(({ group, cards }) => (
        <section class="tool-group" data-group={group.id}>
          <h2 class="group-title">{group.label} <span class="group-hint">{group.hint}</span></h2>
          <div class="tools">
            {cards.map((tool) => (
              <a class="tool-card" href={tool.href} aria-disabled={!tool.available} data-tool-id={TOOL_ID[tool.href]} data-personal={tool.personal ? 'true' : undefined} data-manages={tool.manages ? 'true' : undefined} data-own={tool.personal ? 'true' : undefined}>
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                <span class="cta">Abrir →</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <script>
    import '../client/landing.js';
  </script>
</Base>

<style>
  .hub-loading { min-height: 40vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; }
  .hub-spinner { width: 2rem; height: 2rem; border-radius: 50%; border: 3px solid var(--rm-track, #e9f0f2); border-top-color: var(--rm-accent, #2a9d8f); animation: hub-spin 0.8s linear infinite; }
  @keyframes hub-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hub-spinner { animation: none; } }

  /* Barra del enlace de administracion. Sin pestanas: los grupos son el unico
     eje de agrupacion (ADR de los grupos, regla A). */
  .hub-bar {
    display: flex;
    align-items: center;
    margin: 0 0 1.4rem;
  }
  .admin-link {
    margin-left: auto;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rm-border, #d1d5db);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rm-text, #111827);
    text-decoration: none;
    background: var(--rm-surface, #fff);
  }
  .admin-link:hover { border-color: var(--rm-accent, #2a9d8f); color: var(--rm-accent, #2a9d8f); }
  .admin-link:focus-visible { outline: 2px solid var(--rm-accent, #2a9d8f); outline-offset: 2px; }
  .admin-link .ext { font-size: 0.78rem; opacity: 0.7; }

  /* Grupos: un encabezado discreto y una linea fina. Lo justo para separar sin
     recargar — la tarjeta sigue siendo lo que se mira. */
  .tool-group + .tool-group { margin-top: 2.2rem; }
  .group-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 0.9rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--rm-border, #e5e7eb);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rm-muted, #5b6b7d);
  }
  .group-hint {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--rm-muted, #5b6b7d);
    opacity: 0.85;
  }
  /* El grupo entero desaparece si no le queda ninguna tarjeta visible: un
     encabezado sin nada debajo anuncia algo que no esta. */
  .tool-group[hidden] { display: none; }

  .hero { margin-bottom: 2rem; }
  .page-tagline {
    margin: 0 0 0.75rem;
    color: var(--gr-teal);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--rm-surface);
    border: 1px solid var(--rm-border);
    border-radius: var(--rm-radius);
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    color: var(--rm-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tool-card:hover { border-color: var(--rm-accent); transform: translateY(-2px); }
  /* Las dos puertas que no son herramientas de equipo —la administración y lo
     tuyo— se distinguen sin gritar: el mismo card con el acento marcado arriba.
     Nada de otro color de fondo, que rompería la rejilla (RMR-TSK-0460). */
  .tool-card[data-own] { border-top: 3px solid var(--rm-accent); }
  .tool-card[data-own] h2::after {
    content: '';
    display: inline-block;
    width: 0.4rem; height: 0.4rem; margin-left: 0.45rem; vertical-align: middle;
    border-radius: 50%; background: var(--rm-accent);
  }
  /* La de gobierno, en coral: distinta del verde de las herramientas. */
  .tool-card[data-admin-only] { border-top-color: var(--rm-admin); }
  .tool-card[data-admin-only] h2::after { background: var(--rm-admin); }
  .tool-card[data-admin-only]:hover { border-color: var(--rm-admin); }
  .tool-card[data-admin-only] .cta { color: var(--rm-admin); }
  /* La tarjeta pasa a h3: el h2 es ahora el titulo del grupo, y saltarse un
     nivel rompe el esquema de quien navega con lector de pantalla. */
  .tool-card h3 { margin: 0; font-size: 1.15rem; }
  .tool-card p { margin: 0; color: var(--rm-muted); font-size: 0.9rem; }
  .tool-card .cta { margin-top: auto; color: var(--rm-accent); font-weight: 700; font-size: 0.9rem; }
  .tool-card.placeholder { opacity: 0.6; border-style: dashed; cursor: default; }
  .tool-card.placeholder:hover { border-color: var(--rm-border); transform: none; }

  .back-admin { margin-bottom: 1rem; }
  .back-admin button {
    border: 1px solid var(--rm-border); background: var(--rm-surface); color: var(--rm-accent);
    border-radius: 999px; padding: 0.4rem 1rem; font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .back-admin button:hover { border-color: var(--rm-accent); }
</style>
