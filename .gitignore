# build output
dist/
.output/

# dependencies
node_modules/

# astro
.astro/

# environment (NUNCA commitear credenciales ni config de instancias)
.env
.env.*
!.env.example
# cuentas de despliegue por instancia (deploy:all) — nunca en el repo público
deploy.config.json

# firebase — claves de servicio / Admin SDK (NUNCA commitear)
serviceAccountKey.json
*firebase-adminsdk*.json
*-adminsdk-*.json
*serviceAccount*.json
*-sa.json
*-sa-*.json
portal-metrics-sa*.json
.firebase/
firebase-debug.log*

# Karajan: worktrees y estado de agentes (isolation: worktree) — nunca al repo
.claude/
firestore-debug.log*

# e2e (Playwright): tokens de sesión sembrados y resultados de corrida
e2e/.auth/
test-results/
playwright-report/
.playwright/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
# Karajan v4: el CONTRATO del método se trackea (gate, hooks, roles y reglas)
# para que lo herede cualquiera que clone; los veredictos y cachés locales, no.
.karajan/cache/
.karajan/reviews/
.karajan/*.log
.reviews/
coverage/
.scannerwork/
.karajan/policy-decisions.jsonl
.karajan/audit-history.db
.karajan/identity.local.yml
# El arnés del agente anfitrión (hooks de sesión) NO viaja: lo instala quien
# arranca la sesión, y una copia versionada solo podría mentir sobre lo que de
# verdad está gobernando. Es la opción A del ADR 0009 de karajan, confirmada por
# su equipo. Los hooks de GIT sí se versionan, y por lo contrario: un clon fresco
# tiene esos gates activos desde el segundo cero porque `core.hooksPath` apunta a
# ficheros que viajan.
.karajan/harness/
# El índice del RAG del proyecto (chunks + embeddings, generados desde el propio
# código). Es una caché reconstruible, no el contrato del método: versionarla
# metería megas binarios que quedan obsoletos en el siguiente commit.
.karajan/rag.db
